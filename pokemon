```html
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MBTI로 포켓몬 찾기</title>
<style>
  * { box-sizing: border-box; }

  :root {
    --cream: #fff8e7;
    --card: #fffdf7;
    --yellow: #ffd85c;
    --yellow-light: #fff0b5;
    --brown: #5b4528;
    --muted: #8b7655;
    --border: #f0d58c;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--brown);
    background:
      radial-gradient(circle at 8% 10%, #ffeaa0 0 45px, transparent 46px),
      radial-gradient(circle at 92% 18%, #ffedb1 0 35px, transparent 36px),
      var(--cream);
    font-family: -apple-system, BlinkMacSystemFont, "Noto Sans KR",
      "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  }

  .wrap {
    width: min(900px, calc(100% - 28px));
    margin: auto;
    padding: 42px 0 60px;
  }

  header {
    text-align: center;
    margin-bottom: 28px;
  }

  .tag {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--yellow);
    font-weight: 800;
    margin-bottom: 12px;
  }

  h1 {
    margin: 0;
    font-size: clamp(36px, 8vw, 60px);
    letter-spacing: -3px;
  }

  .subtitle {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: clamp(17px, 3vw, 21px);
    line-height: 1.6;
  }

  .card {
    background: rgba(255, 253, 247, .94);
    border: 2px solid var(--border);
    border-radius: 28px;
    padding: clamp(22px, 5vw, 40px);
    box-shadow: 0 15px 35px rgba(110, 77, 20, .12);
  }

  .question {
    text-align: center;
    margin-bottom: 24px;
  }

  .question h2 {
    margin: 0 0 7px;
    font-size: clamp(24px, 5vw, 32px);
  }

  .question p {
    margin: 0;
    color: var(--muted);
  }

  .mbti-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .mbti {
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 17px 8px;
    background: #fffaf0;
    color: var(--brown);
    font-size: 19px;
    font-weight: 900;
    cursor: pointer;
    transition: .15s ease;
  }

  .mbti:hover,
  .mbti:focus-visible {
    transform: translateY(-3px);
    background: var(--yellow-light);
    border-color: #e8b92e;
    outline: none;
  }

  .result {
    display: none;
    text-align: center;
  }

  .result.show {
    display: block;
  }

  .type {
    display: inline-block;
    padding: 9px 17px;
    border-radius: 999px;
    background: var(--yellow);
    font-weight: 900;
    font-size: 18px;
  }

  .emoji {
    margin: 18px 0 10px;
    font-size: clamp(90px, 22vw, 160px);
    line-height: 1;
  }

  .pokemon {
    margin: 0;
    font-size: clamp(38px, 8vw, 56px);
    letter-spacing: -2px;
  }

  .reason {
    max-width: 650px;
    margin: 20px auto 25px;
    padding: 20px;
    border-radius: 18px;
    background: #fff3c9;
    font-size: 18px;
    line-height: 1.8;
  }

  .compatibility {
    display: inline-block;
    padding: 14px 20px;
    border: 2px solid var(--border);
    border-radius: 16px;
    background: white;
    font-size: 18px;
    font-weight: 800;
  }

  .compatibility strong {
    color: #b87900;
    font-size: 21px;
  }

  .again {
    display: block;
    margin: 27px auto 0;
    padding: 15px 26px;
    border: 0;
    border-radius: 16px;
    background: var(--brown);
    color: white;
    font-size: 18px;
    font-weight: 900;
    cursor: pointer;
  }

  .again:hover,
  .again:focus-visible {
    background: #765a36;
    outline: none;
  }

  .note {
    margin-top: 18px;
    text-align: center;
    color: #a18a63;
    font-size: 14px;
  }

  @media (max-width: 600px) {
    .wrap { padding-top: 28px; }

    .card {
      padding: 20px 15px;
      border-radius: 22px;
    }

    .mbti-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
</head>

<body>
<div class="wrap">

  <header>
    <div class="tag">✨ 나와 닮은 포켓몬은?</div>
    <h1>MBTI로 포켓몬 찾기</h1>
    <p class="subtitle">
      내 MBTI를 골라보세요!<br>
      나와 어울리는 포켓몬을 찾아드릴게요 🐾
    </p>
  </header>

  <main class="card">

    <section id="selection">
      <div class="question">
        <h2>당신의 MBTI는?</h2>
        <p>16가지 유형 중 하나를 선택하세요.</p>
      </div>

      <div class="mbti-grid" id="mbtiGrid"></div>

      <div class="note">※ 재미로 즐기는 성격 유형 콘텐츠입니다.</div>
    </section>

    <section id="result" class="result">
      <div class="type" id="resultType"></div>

      <div class="emoji" id="pokemonEmoji"></div>

      <h2 class="pokemon" id="pokemonName"></h2>

      <div class="reason" id="reason"></div>

      <div class="compatibility">
        💛 잘 맞는 유형:
        <strong id="matchType"></strong>
      </div>

      <button class="again" id="againButton">
        ↩ 다시 고르기
      </button>
    </section>

  </main>
</div>

<script>
const pokemonData = {
  ISTJ: {
    pokemon: "메타몽",
    emoji: "🩷",
    reason: "차분하게 상황을 살피고 맡은 일을 꾸준히 해내는 타입이에요.<br>겉으로는 조용하지만 필요할 때는 확실하게 자기 역할을 합니다.",
    match: "ESFP"
  },

  ISFJ: {
    pokemon: "이브이",
    emoji: "🦊",
    reason: "따뜻하고 다정하며 주변 사람을 세심하게 챙기는 타입이에요.<br>편안한 관계 속에서 자신의 매력을 자연스럽게 보여줍니다.",
    match: "ESTP"
  },

  INFJ: {
    pokemon: "가디안",
    emoji: "🧚",
    reason: "깊이 생각하고 다른 사람의 마음도 잘 이해하는 이상주의자예요.<br>소중한 사람을 지키려는 따뜻한 마음이 가디안과 닮았습니다.",
    match: "ENFP"
  },

  INTJ: {
    pokemon: "뮤츠",
    emoji: "🧬",
    reason: "혼자서도 깊이 생각하며 목표를 향해 전략적으로 움직이는 타입이에요.<br>자신만의 기준과 논리로 세상을 바라보는 모습이 닮았습니다.",
    match: "ENTP"
  },

  ISTP: {
    pokemon: "에이스번",
    emoji: "🐰",
    reason: "필요한 순간 빠르게 움직이고 직접 문제를 해결하는 실전형이에요.<br>자유로운 방식으로 자신의 능력을 발휘하는 모습이 잘 어울립니다.",
    match: "ESFJ"
  },

  ISFP: {
    pokemon: "치라치노",
    emoji: "🐭",
    reason: "부드럽고 감각적이며 자신만의 취향을 중요하게 생각하는 타입이에요.<br>조용하지만 좋아하는 것에는 진심을 다하는 모습이 매력적입니다.",
    match: "ESTJ"
  },

  INFP: {
    pokemon: "토게피",
    emoji: "🥚",
    reason: "순수한 마음과 풍부한 상상력을 가진 이상주의자예요.<br>작은 행복과 따뜻한 관계를 소중하게 여기는 모습이 닮았습니다.",
    match: "ENFJ"
  },

  INTP: {
    pokemon: "폴리곤",
    emoji: "🔺",
    reason: "호기심이 많고 복잡한 것을 파고드는 탐구형이에요.<br>남들이 당연하게 생각하는 것도 자기만의 방식으로 분석합니다.",
    match: "ENTJ"
  },

  ESTP: {
    pokemon: "루카리오",
    emoji: "🐺",
    reason: "행동력이 뛰어나고 눈앞의 상황에 빠르게 대응하는 타입이에요.<br>실전 감각이 좋고 승부의 순간에는 과감하게 움직입니다.",
    match: "ISFJ"
  },

  ESFP: {
    pokemon: "피카츄",
    emoji: "⚡",
    reason: "밝고 에너지가 넘치며 주변 사람들에게 즐거움을 주는 타입이에요.<br>친구들과 함께할 때 더욱 빛나는 모습이 피카츄와 잘 어울립니다.",
    match: "ISTJ"
  },

  ENFP: {
    pokemon: "마릴",
    emoji: "🔵",
    reason: "호기심이 많고 긍정적인 에너지로 새로운 것을 즐기는 타입이에요.<br>친구들과 함께 신나게 모험하는 모습이 잘 어울립니다.",
    match: "INFJ"
  },

  ENTP: {
    pokemon: "후딘",
    emoji: "🥄",
    reason: "아이디어가 풍부하고 기존 방식에 얽매이지 않는 발명가 타입이에요.<br>새로운 가능성을 발견하면 끝까지 파고드는 지적인 매력이 있습니다.",
    match: "INTJ"
  },

  ESTJ: {
    pokemon: "괴력몬",
    emoji: "💪",
    reason: "목표가 분명하고 책임감 있게 일을 추진하는 리더형이에요.<br>필요한 일을 확실하게 해내며 주변을 이끄는 힘이 있습니다.",
    match: "ISFP"
  },

  ESFJ: {
    pokemon: "가디",
    emoji: "🐶",
    reason: "사람들과 잘 어울리고 주변을 든든하게 챙기는 타입이에요.<br>친근하고 충성심이 강해서 함께 있으면 마음이 편안합니다.",
    match: "ISTP"
  },

  ENFJ: {
    pokemon: "님피아",
    emoji: "🎀",
    reason: "사람의 마음을 잘 이해하고 따뜻하게 이끄는 타입이에요.<br>좋은 관계를 만들고 주변 사람에게 긍정적인 영향을 줍니다.",
    match: "INFP"
  },

  ENTJ: {
    pokemon: "레쿠쟈",
    emoji: "🐉",
    reason: "큰 목표를 세우고 자신 있게 앞으로 나아가는 강력한 리더형이에요.<br>어려운 상황에서도 방향을 잃지 않고 문제를 해결하는 힘이 있습니다.",
    match: "INTP"
  }
};

const types = [
  "ISTJ", "ISFJ", "INFJ", "INTJ",
  "ISTP", "ISFP", "INFP", "INTP",
  "ESTP", "ESFP", "ENFP", "ENTP",
  "ESTJ", "ESFJ", "ENFJ", "ENTJ"
];

const grid = document.getElementById("mbtiGrid");
const selection = document.getElementById("selection");
const result = document.getElementById("result");

types.forEach(type => {
  const button = document.createElement("button");

  button.className = "mbti";
  button.textContent = type;
  button.type = "button";

  button.addEventListener("click", () => showResult(type));

  grid.appendChild(button);
});

function showResult(type) {
  const data = pokemonData[type];

  document.getElementById("resultType").textContent =
    `${type}에게 어울리는 포켓몬`;

  document.getElementById("pokemonEmoji").textContent =
    data.emoji;

  document.getElementById("pokemonName").textContent =
    data.pokemon;

  document.getElementById("reason").innerHTML =
    data.reason;

  document.getElementById("matchType").textContent =
    data.match;

  selection.style.display = "none";
  result.classList.add("show");

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
}

document.getElementById("againButton").addEventListener("click", () => {
  result.classList.remove("show");
  selection.style.display = "block";

  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
});
</script>

</body>
</html>
```
